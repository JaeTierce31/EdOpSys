.versions[ref])}));\n  const policy_fixture_hashes=[POLICY,WORKER,VERIFY].map(ref=>({ref,hash:hashCanonical(g.versions[ref])}));\n  const task_pack_hash=hashCanonical(g.versions[TASK]);\n  const cert:any={\n    certification_id:'CLP001Certification',spec_version:'1.0.0',kap_version:'1.0.0',implementation_commit:input.implementation_commit,\n    implementation_commit_binding_status:input.implementation_commit?'BOUND':'PENDING_TARGET_REPOSITORY_COMMIT',test_suite_version:'CLP-001-C-1.0.0',\n    authority_fixture_hashes,policy_fixture_hashes,task_pack_hash,event_count:g.events.length,evidence_count:g.evidence.length,\n    acceptance_results:input.acceptance,adversarial_results:input.adversarial,replay_hash:replay.replay_hash,event_chain_root:chain.root_hash,\n    certified_at:'2026-10-03T23:00:00.000Z',certified_by:'BUILD-CLP-001-C',\n    certification_status:input.implementation_commit?'CERTIFIED':'CERTIFIED_WITH_PENDING_COMMIT_BINDING'\n  };\n  cert.certification_hash=hashCanonical(cert); return cert;\n}\n\"},{\"path\":\"src/node-shims.d.ts\",\"sha256\":\"0cc19ec6c5f57735a717de35da46d1a9ef2dff8becda9e5a0bd9ef7fead6fac0\",\"content\":\"declare module 'node:crypto' { export function createHash(name: string): { update(data: string): any; digest(enc: string): string }; }\n\"},{\"path\":\"tests/golden.test.mjs\",\"sha256\":\"55027d8cb15580f40bb3c479e3cfc7dacc1960e4f428d0bb35c292b0ce77b455\",\"content\":\"import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {\n  buildGoldenCase, InMemoryGovernanceRepository, replayGoldenCase,\n  verifyEventChain, issueCertification, canonicalize, hashCanonical,\n  REQUIRED_ACCEPTANCE_IDS, REQUIRED_ADVERSARIAL_IDS\n} from '../dist/src/index.js';\n\ntest('C-RED-001 builds exactly one closed golden case', () => {\n  const g=buildGoldenCase();\n  assert.equal(g.correlation_id,'corr_CLP001_GOLDEN_001');\n  assert.equal(g.final_state,'CLOSED');\n  assert.equal(g.events[0].event_type,'ResidentIssueReported');\n  assert.equal(g.events.at(-1).event_type,'CaseClosed');\n});\n\ntest('C-RED-002 append-only repository replays from correlation id only',()=>{\n  const g=buildGoldenCase(); const repo=new InMemoryGovernanceRepository(); repo.persistGoldenCase(g);\n  const r=replayGoldenCase(g.correlation_id, repo);\n  assert.equal(r.final_state,'CLOSED');\n  assert.equal(r.correlation_id,g.correlation_id);\n  assert.equal(r.events.length,g.events.length);\n  assert.ok(r.resolved_versions['AUTH-MN-504B161@1.0.0']);\n  assert.ok(r.resolved_versions['AUTH-APPLEVALLEY-PLUMBING@CLP-FIXTURE-1']);\n  assert.ok(r.resolved_versions['TASKPACK-CLP-001@1.0.0']);\n});\n\ntest('C-RED-003 event-chain detects deletion and reordering',()=>{\n  const g=buildGoldenCase();\n  assert.equal(verifyEventChain(g.events,g.event_chain).valid,true);\n  assert.equal(verifyEventChain(g.events.slice(1),g.event_chain).valid,false);\n  const reversed=[...g.events].reverse();\n  assert.equal(verifyEventChain(reversed,g.event_chain).valid,false);\n});\n\ntest('C-RED-004 self-hash is canonical and excludes event_hash itself',()=>{\n  const g=buildGoldenCase(); const e=g.events[0];\n  const copy={...e}; delete copy.event_hash;\n  assert.equal(e.event_hash,hashCanonical(copy));\n  assert.equal(canonicalize({b:2,a:1}),canonicalize({a:1,b:2}));\n});\n\ntest('C-RED-005 certification refuses missing frozen acceptance result',()=>{\n  const g=buildGoldenCase();\n  const acceptance=REQUIRED_ACCEPTANCE_IDS.slice(1).map(id=>({id,status:'PASS'}));\n  const adversarial=REQUIRED_ADVERSARIAL_IDS.map(id=>({id,status:'PASS'}));\n  assert.throws(()=>issueCertification(g,{acceptance,adversarial,implementation_commit:null}),/certification refused/i);\n});\n\ntest('C-RED-006 certification refuses lineage or chain failure',()=>{\n  const g=buildGoldenCase(); g.lineage_nodes.push({id:'BROKEN',parents:['NOPE']});\n  const acceptance=REQUIRED_ACCEPTANCE_IDS.map(id=>({id,status:'PASS'}));\n  const adversarial=REQUIRED_ADVERSARIAL_IDS.map(id=>({id,status:'PASS'}));\n  assert.throws(()=>issueCertification(g,{acceptance,adversarial,implementation_commit:null}),/certification refused/i);\n});\n\ntest('C-RED-007 complete golden case issues machine-verifiable certification',()=>{\n  const g=buildGoldenCase();\n  const acceptance=REQUIRED_ACCEPTANCE_IDS.map(id=>({id,status:'PASS'}));\n  const adversarial=REQUIRED_ADVERSARIAL_IDS.map(id=>({id,status:'PASS'}));\n  const cert=issueCertification(g,{acceptance,adversarial,implementation_commit:null});\n  assert.equal(cert.spec_version,'1.0.0');\n  assert.equal(cert.kap_version,'1.0.0');\n  assert.equal(cert.event_count,g.events.length);\n  assert.equal(cert.evidence_count,g.evidence.length);\n  assert.equal(cert.certification_status,'CERTIFIED_WITH_PENDING_COMMIT_BINDING');\n  assert.match(cert.replay_hash,/^sha256:[0-9a-f]{64}$/);\n  assert.match(cert.certification_hash,/^sha256:[0-9a-f]{64}$/);\n});\n\"},{\"path\":\"tsconfig.json\",\"sha256\":\"44bdc600e793c2bbff8d747cf79b5a24979d839871e1e755e9cb6ece3e01c803\",\"content\":\"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"strict\": true,\n    \"outDir\": \"dist\",\n    \"rootDir\": \".\",\n    \"declaration\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"lib\": [\"ES2022\", \"DOM\"]\n  },\n  \"include\": [\"src/**/*.ts\"]\n}\n\"}]}