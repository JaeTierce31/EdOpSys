r VERIFIED\nok 25 - AT-016 completion enters AWAITING_VERIFICATION, never VERIFIED\n  ---\n  duration_ms: 0.063576\n  type: 'test'\n  ...\n# Subtest: AT-017 independent verifier is required\nok 26 - AT-017 independent verifier is required\n  ---\n  duration_ms: 0.090346\n  type: 'test'\n  ...\n# Subtest: AT-018 continuing-running verification failure blocks verification\nok 27 - AT-018 continuing-running verification failure blocks verification\n  ---\n  duration_ms: 0.759954\n  type: 'test'\n  ...\n# Subtest: AT-019 all V1-V8 checks pass as VERIFIED\nok 28 - AT-019 all V1-V8 checks pass as VERIFIED\n  ---\n  duration_ms: 0.083085\n  type: 'test'\n  ...\n# Subtest: ADV-005 stale task pack version/hash is rejected\nok 29 - ADV-005 stale task pack version/hash is rejected\n  ---\n  duration_ms: 0.07313\n  type: 'test'\n  ...\n# Subtest: ADV-006 worker self-verification is rejected\nok 30 - ADV-006 worker self-verification is rejected\n  ---\n  duration_ms: 0.056555\n  type: 'test'\n  ...\n# Subtest: AT-020 WorkGraph requires preceding RepairVerified event\nok 31 - AT-020 WorkGraph requires preceding RepairVerified event\n  ---\n  duration_ms: 0.170987\n  type: 'test'\n  ...\n# Subtest: AT-021 WorkGraph does not fabricate licensure\nok 32 - AT-021 WorkGraph does not fabricate licensure\n  ---\n  duration_ms: 0.08693\n  type: 'test'\n  ...\n# Subtest: AT-022 portable receipt strips resident-identifying data\nok 33 - AT-022 portable receipt strips resident-identifying data\n  ---\n  duration_ms: 0.116665\n  type: 'test'\n  ...\n# Subtest: AT-025 broken lineage fails certification\nok 34 - AT-025 broken lineage fails certification\n  ---\n  duration_ms: 0.25897\n  type: 'test'\n  ...\n# Subtest: AT-026 replay reconstructs case solely by correlation id\nok 35 - AT-026 replay reconstructs case solely by correlation id\n  ---\n  duration_ms: 0.60449\n  type: 'test'\n  ...\n# Subtest: AT-027 historical replay pins original versions after new versions exist\nok 36 - AT-027 historical replay pins original versions after new versions exist\n  ---\n  duration_ms: 0.096555\n  type: 'test'\n  ...\n# Subtest: AT-028 current-versus-historical resolution remains separate\nok 37 - AT-028 current-versus-historical resolution remains separate\n  ---\n  duration_ms: 0.084818\n  type: 'test'\n  ...\n1..37\n# tests 37\n# suites 0\n# pass 37\n# fail 0\n# cancelled 0\n# skipped 0\n# todo 0\n# duration_ms 75.773141\n"},{"path":"scripts/verify-guardrails.mjs","sha256":"4690ea3191bfd39c1a34fa28e4b9a3faf509bc422de44670eec905c10e0a74e8","content":"import fs from 'node:fs';\nimport path from 'node:path';\nimport crypto from 'node:crypto';\nimport { fileURLToPath } from 'node:url';\nimport { evaluateEligibility } from '../dist/src/index.js';\n\nconst here=path.dirname(fileURLToPath(import.meta.url));\nconst root=path.resolve(here,'..');\nconst a=path.resolve(root,'input/BUILD-CLP-001-A');\nconst sha256=b=>crypto.createHash('sha256').update(b).digest('hex');\nconst readJson=p=>JSON.parse(fs.readFileSync(p,'utf8'));\n\nconst manifest=readJson(path.join(a,'manifest.json'));\nconst bad=[];\nfor(const entry of manifest.files){\n  const p=path.join(a,entry.path);\n  const bytes=fs.readFileSync(p);\n  if(sha256(bytes)!==entry.sha256) bad.push(entry.path);\n}\nif(bad.length) throw new Error(`A bundle manifest mismatch: ${bad.join(', ')}`);\n\nconst testText=fs.readFileSync(path.join(root,'tests/kernel.test.mjs'),'utf8');\nconst missing=[];\nfor(let i=1;i<=30;i++){\n  const id=`AT-${String(i).padStart(3,'0')}`;\n  if(!testText.includes(id)) missing.push(id);\n}\nfor(let i=1;i<=7;i++){\n  const id=`ADV-${String(i).padStart(3,'0')}`;\n  if(!testText.includes(id)) missing.push(id);\n}\nif(missing.length) throw new Error(`Missing frozen test IDs: ${missing.join(', ')}`);\n\nconst workers=readJson(path.join(a,'fixtures/workers.json'));\nfor(const w of workers){\n  const actual=evaluateEligibility(w).decision;\n  if(actual!==w.expected_decision) throw new Error(`${w.worker_id}: expected ${w.expected_decision}, got ${actual}`);\n}\n\nconst policy=readJson(path.join(a,'fixtures/transition-policy.json'));\nif(policy.reject_unlisted_transitions!==true) throw new Error('transition policy does not fail closed');\nif(policy.transitions.length!==24) throw new Error(`expected 24 frozen transitions, got ${policy.transitions.length}`);\n\nconsole.log(JSON.stringify({\n  status:'PASS',\n  a_manifest_entries:manifest.files.length,\n  frozen_test_ids:37,\n  worker_fixtures:workers.map(w=>({worker_id:w.worker_id,decision:evaluateEligibility(w).decision})),\n  transition_count:policy.transitions.length,\n  reject_unlisted_transitions:true\n},null,2));\n"},{"path":"src/index.ts","sha256":"53ce8e5e3c237032b61255a4b9bbfafeaa50826b752e0d6dcc4d13f5b75d2657","content":"import { createHash } from 'node:crypto';\n\nexport type CaseState = string;\nexport type DomainEvent = {\n  event_id: string;\n  event_type: string;\n  aggregate_id: string;\n  aggregate_version: number;\n  correlation_id: string;\n  causation_event_id: string | null;\n  event_hash: string;\n  source_refs?: string[];\n  policy_refs?: string[];\n  evidence_refs?: string[];\n};\n\nexport type EvidenceArtifact = {\n  evidence_id: string;\n  evidence_class: string;\n  evidence_type: string;\n  content: unknown;\n  parent_evidence_ids: string[];\n  content_hash: string;\n  created_at: string;\n  verification_status: string;\n};\n\nexport type WorkerFixture = {\n  worker_id: string;\n  employment_authorization: string;\n  property_authorization: string;\n  maintenance_role: string;\n  capabilities: { basic_plumbing_maintenance: string };\n  trainings: { fixture_repair_training: string };\n  credentials_current: boolean;\n  disciplinary_block: string;\n  supervision_required: boolean;\n  supervision_present: boolean;\n  expected_decision: string;\n};\n\nfunction normalize(value: unknown): unknown {\n  if (value === null || typeof value !== 'object') {\n    if (typeof value === 'number' && !Number.isFinite(value)) throw new Error('non-finite numbers are not canonicalizable');\n    return value;\n  }\n  if (Array.isArray(value)) return value.map(normalize);\n  const out: Record<string, unknown> = {};\n  for (const key of Object.keys(value as Record<string, unknown>).sort()) {\n    const v = (value as Record<string, unknown>)[key];\n    if (v !== undefined) out[key] = normalize(v);\n  }\n  return out;\n}\n\nexport function canonicalize(value: unknown): string {\n  return JSON.stringify(normalize(value));\n}\n\nexport function hashCanonical(value: unknown): string {\n  return 'sha256:' + createHash('sha256').update(canonicalize(value)).digest('hex');\n}\n\nexport function initializeCase(caseId: string) {\n  if (!caseId) throw new Error('case id required');\n  return { case_id: caseId, state: 'REPORTED' as CaseState };\n}\n\nexport function authorizeTransition(\n  policy: any,\n  from: string,\n  to: string,\n  eventType: string,\n  satisfiedGuards: Set<string>\n) {\n  const candidate = policy.transitions.find((t: any) => t.from === from && t.to === to && t.event_type === eventType);\n  if (!candidate) return { allowed: false, reason: 'UNLISTED_TRANSITION' };\n  const missing = (candidate.guards ?? []).filter((g: string) => !satisfiedGuards.has(g));\n  return missing.length === 0\n    ? { allowed: true, transition_id: candidate.transition_id, missing_guards: [] }\n    : { allowed: false, reason: 'GUARD_FAILED', transition_id: candidate.transition_id, missing_guards: missing };\n}\n\nexport function verifyEventSequence(events: DomainEvent[]): true {\n  const byAggregate = new Map<string, DomainEvent[]>();\n  for (const e of events) {\n    const list = byAggregate.get(e.aggregate_id) ?? [];\n    list.push(e);\n    byAggregate.set(e.aggregate_id, list);\n  }\n  for (const list of byAggregate.values()) {\n    let prior = 0;\n    for (const e of list) {\n      if (e.aggregate_version !== prior + 1) throw new Error('aggregate versions must be monotonic +1');\n      prior = e.aggregate_version;\n    }\n  }\n  return true;\n}\n\nexport function appendEvidence(\n  ledger: EvidenceArtifact[],\n  input: { evidence_id: string; evidence_class: string; evidence_type: string; content: unknown; parent_evidence_ids: string[] }\n): EvidenceArtifact {\n  if (ledger.some(x => x.evidence_id === input.evidence_id)) throw new Error('evidence id already exists');\n  if (input.evidence_class === 'E1' && input.parent_evidence_ids.length === 0) throw new Error('E1 derived evidence requires parent evidence');\n  for (const parent of input.parent_evidence_ids) {\n    if (!ledger.some(x => x.evidence_id === parent)) throw new Error(`missing parent evidence: ${parent}`);\n  }\n  const artifact: EvidenceArtifact = {\n    ...input,\n    created_at: new Date(0).toISOString(),\n    verification_status: 'UNVERIFIED',\n    content_hash: hashCanonical({\n      evidence_id: input.evidence_id,\n      evidence_class: input.evidence_class,\n      evidence_type: input.evidence_type,\n      content: input.content,\n      parent_evidence_ids: input.parent_evidence_ids\n    })\n  };\n  ledger.push(Object.freeze(artifact));\n  return artifact;\n}\n\nexport function verifyArtifactHash(e: EvidenceArtifact): boolean {\n  const expected = hashCanonical({\n    evidence_id: e.evidence_id,\n    evidence_class: e.evidence_class,\n    evidence_type: e.evidence_type,\n    content: e.content,\n    parent_evidence_ids: e.parent_evidence_ids\n  });\n  return expected === e.content_hash;\n}\n\nexport function deleteEvidence(_ledger: EvidenceArtifact[], _id: string): never {\n  throw new Error('evidence ledger is append-only; destructive deletion prohibited');\n}\n\nconst requiredAuthorityFields = [\n  'source_id','source_class','jurisdiction','version','effective_from','effective_until',\n  'retrieved_at','content_hash','official_source','verification_status'\n];\n\nexport function validateAuthorityProvenance(source: Record<string, unknown>) {\n  const missing = requiredAuthorityFields.filter(k => !(k in source));\n  const hashOk = typeof source.content_hash === 'string' && /^sha256:[0-9a-f]{64}$/.test(source.content_hash);\n  return { valid: missing.length === 0 && hashOk, missing, hash_ok: hashOk };\n}\n\nexport function resolveApplicability(source: any, targetJurisdiction: string) {\n  if (source.status === 'SUPERSEDED') return { status: 'SUPERSEDED' };\n  if (source.conditional === true) return { status: 'POTENTIALLY_APPLICABLE' };\n  if (source.jurisdiction === 'US-FEDERAL') return { status: 'POTENTIALLY_APPLICABLE' };\n  if (targetJurisdiction === source.jurisdiction || targetJurisdiction.startsWith(source.jurisdiction + '-')) {\n    return { status: 'APPLICABLE' };\n  }\n  return { status: 'NOT_APPLICABLE' };\n}\n\nexport function validateRightsAnswer(answer: any, knownSourceIds: Set<string>) {\n  const allowed = new Set(['A0','A1','A2','A3']);\n  const errors: string[] = [];\n  if (!allowed.has(answer.answer_class)) errors.push('answer class not allowed');\n  if (answer.legal_liability_finding) errors.push('autonomous legal liability finding prohibited');\n  for (const claim of answer.claims ?? []) {\n    if (!Array.isArray(claim.source_ids) || claim.source_ids.length === 0) errors.push('uncited consequential claim');\n    for (const id of claim.source_ids ?? []) if (!knownSourceIds.has(id)) errors.push(`unknown citation ${id}`);\n  }\n  return { valid: errors.length === 0, errors };\n}\n\nexport function createWorkOrder(input: { work_order_id: string; resident_issue_id: string; authority_refs: string[] }) {\n  if (!input.resident_issue_id || !input.authority_refs?.length) throw new Error('work order provenance required');\n  return { ...input };\n}\n\nexport function evaluateEligibility(worker: WorkerFixture, _context?: { aiRecommendation?: string }) {\n  const predicate_results = {\n    EMPLOYMENT_AUTHORIZED: worker.employment_authorization === 'ACTIVE',\n    PROPERTY_AUTHORIZED: worker.property_authorization === 'ACTIVE',\n    TASK_CAPABILITY_VERIFIED: worker.capabilities.basic_plumbing_maintenance === 'VERIFIED',\n    REQUIRED_TRAINING_CURRENT: worker.trainings.fixture_repair_training === 'CURRENT',\n    CREDENTIALS_CURRENT: worker.credentials_current === true,\n    NO_TASK_RESTRICTION: worker.disciplinary_block === 'NONE',\n    NO_REQUIRED_SUPERVISION_MISSING: !worker.supervision_required || worker.supervision_present\n  };\n  let decision = 'ELIGIBLE';\n  if (!predicate_results.EMPLOYMENT_AUTHORIZED || !predicate_results.PROPERTY_AUTHORIZED) decision = 'INELIGIBLE_AUTHORIZATION';\n  else if (!predicate_results.TASK_CAPABILITY_VERIFIED || !predicate_results.REQUIRED_TRAINING_CURRENT || !predicate_results.CREDENTIALS_CURRENT) decision = 'INELIGIBLE_CAPABILITY';\n  else if (!predicate_results.NO_TASK_RESTRICTION || !predicate_results.NO_REQUIRED_SUPERVISION_MISSING) decision = 'INELIGIBLE_AUTHORIZATION';\n  return { worker_id: worker.worker_id, decision, predicate_results, decision_hash: hashCanonical({worker_id: worker.worker_id, decision, predicate_results}) };\n}\n\nexport function assertCredentialIntegrity(record: { worker_id: string; credentials_current: boolean; content_hash: string }) {\n  return record.content_hash === hashCanonical({worker_id: record.worker_id, credentials_current: record.credentials_current});\n}\n\nexport function validateTaskPack(pack: { status: string; approval_status: string; payload: unknown; task_pack_hash: string }) {\n  const hashMatches = pack.task_pack_hash === hashCanonical(pack.payload);\n  return { valid: pack.status === 'ACTIVE' && pack.approval_status === 'APPROVED' && hashMatches, hashMatches };\n}\n\nexport function validateTaskPackExecutionVersion(x: { assignedVersion: string; assignedHash: string; executedVersion: string; executedHash: string }) {\n  return x.assignedVersion === x.executedVersion && x.assignedHash === x.executedHash;\n}\n\nexport function detectStopCondition(facts: Record<string, boolean>): string | null {\n  if (facts.sewage_backup || facts.contaminated_discharge || facts.sanitary_overflow) return 'STOP-SEWAGE';\n  if (facts.failed_shutoff || facts.uncontrolled_water_supply || facts.concealed_supply_leak) return 'STOP-SUPPLY';\n  if (facts.soft_flooring || facts.subfloor_damage || facts.unstable_fixture || facts.structural_deterioration) return 'STOP-STRUCTURAL';\n  if (facts.water_threatens_electrical) return 'STOP-ELECTRICAL';\n  if (facts.outside_scope) return 'STOP-SCOPE';\n  if (facts.credential_invalid) return 'STOP-CREDENTIAL';\n  if (facts.procedure_unresolved) return 'STOP-PROCEDURE';\n  if (facts.evidence_unobtainable) return 'STOP-EVIDENCE';\n  return null;\n}\n\nexport function submitCompletion(x: { completeEvidence: boolean; noStopCondition: boolean }) {\n  if (!x.completeEvidence) return { state: 'IN_PROGRESS', accepted: false };\n  if (!x.noStopCondition) return { state: 'ESCALATED', accepted: false };\n  return { state: 'AWAITING_VERIFICATION', accepted: true };\n}\n\nexport function verifyRepair(x: { workerId: string; verifierId: string; checks: boolean[]; taskPackHashMatches: boolean }) {\n  if (x.workerId === x.verifierId) return { result: 'REJECTED' };\n  if (x.checks.length !== 8) return { result: 'INCONCLUSIVE' };\n  if (!x.taskPackHashMatches) return { result: 'FAILED' };\n  return { result: x.checks.every(Boolean) ? 'VERIFIED' : 'FAILED' };\n}\n\nexport function issueWorkGraphReceipt(x: { events: DomainEvent[]; workerId: string; taskClass: string; licensed: boolean }) {\n  if (!x.events.some(e => e.event_type === 'RepairVerified')) throw new Error('RepairVerified event required before WorkGraph issuance');\n  const claims = ['VERIFIED_TASK', `TASK_CLASS:${x.taskClass}`];\n  if (x.licensed) claims.push('LICENSED_PLUMBER');\n  return { worker_id: x.workerId, task_class: x.taskClass, claims, receipt_hash: hashCanonical({worker_id:x.workerId, task_class:x.taskClass, claims}) };\n}\n\nexport function portableWorkGraph(receipt: Record<string, unknown>) {\n  const denied = new